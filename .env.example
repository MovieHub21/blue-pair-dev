# Supabase project URL. Used for health checks and the Supabase admin API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# SERVER ONLY. Supabase connection pooler/direct connection string.
# Prefer the transaction/session pooler URL supplied by Supabase for your deployment.
DATABASE_URL=postgresql://postgres.jyllymseodyvuzkatdzp:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Environment row used by the existing Blue Pair site_settings table.
SITE_ENVIRONMENT=production

# Security adapter. Your auth layer should set this exact HttpOnly cookie after authenticating you.
DEV_CONTROL_COOKIE=bp_dev_control
DEV_CONTROL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Keep false unless you deliberately want the raw SQL console enabled.
ENABLE_SQL_CONSOLE=false

# Optional display only.
NEXT_PUBLIC_SITE_URL=https://your-blue-pair-site.example
